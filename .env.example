# =============================================================================
# CALLBOT - Configuración
# Copiar a .env y completar. NUNCA commitear el .env real.
# =============================================================================

# ---------- Postgres ----------
POSTGRES_USER=callbot
POSTGRES_PASSWORD=cambiar_esta_password
POSTGRES_DB=callbot
POSTGRES_PORT=5432

# ---------- API ----------
API_PORT=8000
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar_esta_password
# Token compartido entre la API y el voice-agent. Protege /internal/* de que
# alguien inyecte respuestas de encuesta si el puerto 8000 queda expuesto.
#   generar con: openssl rand -hex 32
INTERNAL_TOKEN=cambiar_por_un_token_aleatorio

# --- Acceso desde el CRM (pestaña "Calidad") -------------------------------
# Secreto compartido con el CRM, que firma los tickets. MISMO valor en las dos
# apps. Mínimo 32 caracteres; vacío = acceso desde el CRM desactivado (no
# existe /sso). Generar:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotarlo cierra TODAS las sesiones abiertas de una vez.
CALLBOT_SSO_SECRET=
# Orígenes que pueden enmarcar el panel, separados por espacio. Sin ';' ni comodines.
FRAME_ANCESTORS=https://crm.santarosa.lat

# --- Login con la cuenta de los dashboards (Supabase) ------------------------
# La misma cuenta de Meta Ads y del tablero comercial: una persona, un usuario.
# URL del Supabase de los dashboards (el que proxean bajo /supabase) y su clave
# anónima, que es pública por diseño. Vacío = no hay formulario de ingreso;
# queda el acceso desde el CRM y la credencial de operación.
# Requiere CALLBOT_SSO_SECRET: la sesión se firma con él.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Dominios de correo que pueden entrar (coma).
LOGIN_DOMINIOS=santarosa.com.py
# rol de los dashboards:rol en Callbot. Lo que no figura, no entra. Por defecto
# brand y administracion quedan fuera: las encuestas llevan teléfonos de clientes.
LOGIN_ROLES=super_admin:admin,manager:calidad
LOG_LEVEL=INFO
TZ=America/Asuncion

# ---------- Bitrix24 ----------
# Webhook entrante: Bitrix24 > Aplicaciones > Webhooks > Webhook entrante
# Formato: https://TU-PORTAL.bitrix24.com/rest/1/TOKEN/
BITRIX_WEBHOOK_URL=https://tu-portal.bitrix24.com/rest/1/xxxxxxxxxxxx/

# Entidad donde viven las fechas del taller.
# 2 = Deal (negocio) | 1036, 1038... = Smart Process (SPA)
# Descubrí el ID real con: make bitrix-discover
BITRIX_ENTITY_TYPE_ID=1036

# Códigos de campo dentro de esa entidad (descubrilos con make bitrix-discover)
# T0 del conteo de 48hs:
BITRIX_FIELD_WORKSHOP_ENTRY=ufCrm5FechaIngresoTaller
# Informativos, se guardan junto con la encuesta:
BITRIX_FIELD_INVOICE_DATE=ufCrm5FechaRealFacturacion
BITRIX_FIELD_DELIVERY_DATE=ufCrm5FechaRealEntrega
# Vínculo al contacto y teléfono
BITRIX_FIELD_CONTACT_ID=contactId
# Campo opcional donde escribir el puntaje final (dejar vacío para no escribir)
BITRIX_FIELD_SCORE_WRITEBACK=
# Si es true, además deja un comentario en el timeline con el resumen
BITRIX_TIMELINE_COMMENT=true
# Registrar la llamada en la telefonía de Bitrix (telephony.externalcall.*)
BITRIX_REGISTER_CALL=true
BITRIX_TELEPHONY_USER_ID=1

# ---------- Reglas de la encuesta ----------
SURVEY_DELAY_HOURS=48
# Ventana horaria permitida para llamar (hora local TZ)
CALL_WINDOW_START=09:00
CALL_WINDOW_END=19:00
# Días permitidos: 0=lunes ... 6=domingo
CALL_WINDOW_DAYS=0,1,2,3,4,5
MAX_CALL_ATTEMPTS=3
RETRY_INTERVAL_MINUTES=180
# Cada cuántos minutos el scheduler consulta Bitrix por nuevos registros
BITRIX_POLL_INTERVAL_MINUTES=15
# Llamadas simultáneas máximas (con softphone dejalo en 1)
MAX_CONCURRENT_CALLS=1
# Si el canal no llega al voice-agent en este tiempo, se marca como no atendida
CALL_ANSWER_TIMEOUT_SECONDS=90

# ---------- Asterisk / ARI ----------
ARI_URL=http://asterisk:8088
# Con Asterisk en el VPS de Hetzner: http://<IP de Tailscale del VPS>:8088 (ver deploy/vps-asterisk/)
ARI_USER=callbot
ARI_PASSWORD=cambiar_esta_password
ARI_APP=callbot
# Plantilla del endpoint a marcar. {number} = teléfono en E.164 sin el '+'.
#   DEV  (softphone): PJSIP/softphone-1          <- ignora el número, siempre suena tu softphone
#   PROD (troncal):   PJSIP/{number}@trunk-proveedor
ASTERISK_DIAL_TEMPLATE=PJSIP/softphone-1
ASTERISK_CONTEXT=callbot-outbound
ASTERISK_EXTENSION=start
ASTERISK_CALLERID=Callbot <1000>
ASTERISK_DIAL_TIMEOUT=45
# Puertos SIP/RTP expuestos por el contenedor
SIP_PORT=5060
# Con Asterisk en el VPS: la IP de Tailscale de ESTE servidor, para que el VPS alcance el AudioSocket (se publica en el 18090: el 8090 del host es de Coolify).
AUDIOSOCKET_BIND=127.0.0.1
RTP_START=10000
RTP_END=10050

# Softphones de desarrollo (Linphone/Zoiper se registran con estos datos)
#   usuario: softphone-1 / softphone-2   servidor: IP_DEL_SERVIDOR
SOFTPHONE_PASSWORD=callbot123

# IP del host por la que llegan los softphones. Asterisk la anuncia en el SDP.
# Vacío = sin reescritura de NAT, que sirve solo si Asterisk NO corre en Docker.
# Con Docker, dejarlo vacío hace que la llamada conecte pero sin audio.
SIP_EXTERNAL_ADDRESS=

# Troncal SIP de producción (dejar vacío mientras se use softphone)
TRUNK_HOST=
TRUNK_USER=
TRUNK_PASSWORD=

# ---------- Voice agent ----------
AUDIOSOCKET_PORT=8090
# Whisper: tiny|base|small|medium|large-v3 (con GPU: medium o large-v3)
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=es
# --- Voz del bot ---
# Voicebox (https://github.com/jamiepine/voicebox) permite llamar con una voz
# CLONADA de una persona real. Corre aparte, con su propio docker compose.
# Dejar VOICEBOX_URL vacío usa Piper (voz genérica, sin clonación).
#
#   1. Levantar voicebox:  cd ../voicebox && docker compose up -d
#   2. Clonar la voz:      python scripts/voicebox_voice.py clone --name "..." \
#                            --audio grabacion.wav --text "transcripción exacta"
#   3. Pegar el id acá abajo
#
# Necesitás permiso explícito de la persona cuya voz vas a clonar.
VOICEBOX_URL=
# En producción: http://voicebox:17493 (ver deploy/voicebox/)
VOICEBOX_PROFILE_ID=
# Motor TTS: qwen | qwen_custom_voice | luxtts | chatterbox | chatterbox_turbo | tada | kokoro
VOICEBOX_ENGINE=qwen
VOICEBOX_LANGUAGE=es
# Precalentado al arrancar: nadie espera, puede tardar
VOICEBOX_WARMUP_TIMEOUT=300
# En llamada: si voicebox no contesta en este tiempo, habla Piper
VOICEBOX_CALL_TIMEOUT=8

# VoiceStudio (OmniVoice, https://github.com/debpalash/VoiceStudio): clona voces desde el panel
# (Voces → Clonar) y las hace hablar en vivo. Necesita GPU: en CPU una frase tarda ~25 s.
# Vacío = no se ofrece clonar. Las campañas lo usan con un perfil "vs:<id>".
VOICESTUDIO_URL=
# La misma clave que OMNIVOICE_API_KEY del contenedor de VoiceStudio (no la expongas a internet)
VOICESTUDIO_API_KEY=

# Piper: respaldo, y motor principal si no hay voicebox.
# Voz descargada por scripts/download_models.sh
PIPER_VOICE=es_AR-daniela-high
# Detección de fin de respuesta
VAD_AGGRESSIVENESS=2
SILENCE_MS_TO_STOP=1200
MAX_ANSWER_SECONDS=30
NO_SPEECH_TIMEOUT_SECONDS=8
# Guardar el audio de cada respuesta en disco
SAVE_AUDIO=true

# ---------- Claude (toda la IA de la plataforma) ----------
# La misma clave que usan Santa Rosa Ads, el asistente de los tableros y la Agencia IA.
# Claude conversa en la llamada, analiza después, redacta las instrucciones del agente,
# arma el contexto de la empresa y responde las consultas sobre las llamadas. Sin clave,
# el bot usa las frases fijas y no hay análisis. OJO: las transcripciones se envían a Anthropic.
ANTHROPIC_API_KEY=
CALLBOT_LLM_MODEL=claude-haiku-5-5
# Segundos que se espera a Claude en llamada antes de decir la frase fija.
CALLBOT_LLM_TIMEOUT=8
