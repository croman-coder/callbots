# =============================================================================
# CALLBOT - Configuración
# Copiar a .env y completar. NUNCA commitear el .env real.
# =============================================================================

# ---------- Postgres ----------
POSTGRES_USER=callbot
POSTGRES_PASSWORD=cambiar_esta_password
POSTGRES_DB=callbot
POSTGRES_PORT=5432

# ---------- API ----------
API_PORT=8000
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar_esta_password
# Token compartido entre la API y el voice-agent. Protege /internal/* de que
# alguien inyecte respuestas de encuesta si el puerto 8000 queda expuesto.
#   generar con: openssl rand -hex 32
INTERNAL_TOKEN=cambiar_por_un_token_aleatorio
LOG_LEVEL=INFO
TZ=America/Asuncion

# ---------- Bitrix24 ----------
# Webhook entrante: Bitrix24 > Aplicaciones > Webhooks > Webhook entrante
# Formato: https://TU-PORTAL.bitrix24.com/rest/1/TOKEN/
BITRIX_WEBHOOK_URL=https://tu-portal.bitrix24.com/rest/1/xxxxxxxxxxxx/

# Entidad donde viven las fechas del taller.
# 2 = Deal (negocio) | 1036, 1038... = Smart Process (SPA)
# Descubrí el ID real con: make bitrix-discover
BITRIX_ENTITY_TYPE_ID=1036

# Códigos de campo dentro de esa entidad (descubrilos con make bitrix-discover)
# T0 del conteo de 48hs:
BITRIX_FIELD_WORKSHOP_ENTRY=ufCrm5FechaIngresoTaller
# Informativos, se guardan junto con la encuesta:
BITRIX_FIELD_INVOICE_DATE=ufCrm5FechaRealFacturacion
BITRIX_FIELD_DELIVERY_DATE=ufCrm5FechaRealEntrega
# Vínculo al contacto y teléfono
BITRIX_FIELD_CONTACT_ID=contactId
# Campo opcional donde escribir el puntaje final (dejar vacío para no escribir)
BITRIX_FIELD_SCORE_WRITEBACK=
# Si es true, además deja un comentario en el timeline con el resumen
BITRIX_TIMELINE_COMMENT=true
# Registrar la llamada en la telefonía de Bitrix (telephony.externalcall.*)
BITRIX_REGISTER_CALL=true
BITRIX_TELEPHONY_USER_ID=1

# ---------- Reglas de la encuesta ----------
SURVEY_DELAY_HOURS=48
# Ventana horaria permitida para llamar (hora local TZ)
CALL_WINDOW_START=09:00
CALL_WINDOW_END=19:00
# Días permitidos: 0=lunes ... 6=domingo
CALL_WINDOW_DAYS=0,1,2,3,4,5
MAX_CALL_ATTEMPTS=3
RETRY_INTERVAL_MINUTES=180
# Cada cuántos minutos el scheduler consulta Bitrix por nuevos registros
BITRIX_POLL_INTERVAL_MINUTES=15
# Llamadas simultáneas máximas (con softphone dejalo en 1)
MAX_CONCURRENT_CALLS=1
# Si el canal no llega al voice-agent en este tiempo, se marca como no atendida
CALL_ANSWER_TIMEOUT_SECONDS=90

# ---------- Asterisk / ARI ----------
ARI_URL=http://asterisk:8088
ARI_USER=callbot
ARI_PASSWORD=cambiar_esta_password
ARI_APP=callbot
# Plantilla del endpoint a marcar. {number} = teléfono en E.164 sin el '+'.
#   DEV  (softphone): PJSIP/softphone-1          <- ignora el número, siempre suena tu softphone
#   PROD (troncal):   PJSIP/{number}@trunk-proveedor
ASTERISK_DIAL_TEMPLATE=PJSIP/softphone-1
ASTERISK_CONTEXT=callbot-outbound
ASTERISK_EXTENSION=start
ASTERISK_CALLERID=Callbot <1000>
ASTERISK_DIAL_TIMEOUT=45
# Puertos SIP/RTP expuestos por el contenedor
SIP_PORT=5060
RTP_START=10000
RTP_END=10050

# Softphones de desarrollo (Linphone/Zoiper se registran con estos datos)
#   usuario: softphone-1 / softphone-2   servidor: IP_DEL_SERVIDOR
SOFTPHONE_PASSWORD=callbot123

# Troncal SIP de producción (dejar vacío mientras se use softphone)
TRUNK_HOST=
TRUNK_USER=
TRUNK_PASSWORD=

# ---------- Voice agent ----------
AUDIOSOCKET_PORT=8090
# Whisper: tiny|base|small|medium|large-v3 (con GPU: medium o large-v3)
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=es
# Piper: voz descargada por scripts/download_models.sh
PIPER_VOICE=es_AR-daniela-high
# Detección de fin de respuesta
VAD_AGGRESSIVENESS=2
SILENCE_MS_TO_STOP=1200
MAX_ANSWER_SECONDS=30
NO_SPEECH_TIMEOUT_SECONDS=8
# Guardar el audio de cada respuesta en disco
SAVE_AUDIO=true

# ---------- Ollama (análisis post-llamada) ----------
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_ENABLED=true
